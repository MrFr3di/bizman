{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bizman/event.schema.json",
  "title": "BizMan normalized runtime event",
  "type": "object",
  "required": [
    "schema_version", "event_id", "session_id", "sequence", "observed_at",
    "monotonic_time", "source", "event_type", "confidence"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sequence": {"type": "integer", "minimum": 0},
    "observed_at": {"type": "string", "format": "date-time"},
    "monotonic_time": {"type": "number", "minimum": 0},
    "source_monotonic_time": {"type": ["number", "null"], "minimum": 0},
    "source": {
      "enum": [
        "cdp.network", "cdp.page", "cdp.runtime", "dom.action", "bas.action", "system"
      ]
    },
    "event_type": {"type": "string", "minLength": 1},
    "confidence": {
      "enum": [
        "observed", "documented", "discovered-reference", "inferred", "hypothesis",
        "verified", "contradicted", "deprecated"
      ]
    },
    "target_id": {"type": ["string", "null"]},
    "frame_id": {"type": ["string", "null"]},
    "loader_id": {"type": ["string", "null"]},
    "request_id": {"type": ["string", "null"]},
    "redirect_index": {"type": "integer", "minimum": 0},
    "method": {"type": ["string", "null"]},
    "url_path": {"type": ["string", "null"]},
    "route_pattern": {"type": ["string", "null"]},
    "status_code": {
      "type": ["integer", "null"],
      "minimum": 100,
      "maximum": 599
    },
    "request_body_ref": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "response_body_ref": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fingerprint": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "action_refs": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "action_kind": {"type": ["string", "null"], "enum": ["click", "change", "submit", null]},
    "is_trusted": {"type": ["boolean", "null"]},
    "page_path": {"type": ["string", "null"], "maxLength": 1024},
    "element_tag": {"type": ["string", "null"], "maxLength": 32},
    "element_type": {"type": ["string", "null"], "maxLength": 32},
    "element_name": {"type": ["string", "null"], "maxLength": 128},
    "element_role": {"type": ["string", "null"], "maxLength": 64},
    "safe_selector": {"type": ["string", "null"], "maxLength": 128},
    "form_action_path": {"type": ["string", "null"], "maxLength": 1024},
    "form_method": {"type": ["string", "null"], "maxLength": 16},
    "form_field_names": {
      "type": "array",
      "maxItems": 128,
      "items": {"type": "string", "minLength": 1, "maxLength": 128},
      "uniqueItems": true
    },
    "action_event_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "network_event_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "correlation_status": {
      "type": ["string", "null"],
      "enum": ["strong", "probable", "temporal-only", "exact", null]
    },
    "correlation_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "delta_ms": {"type": ["number", "null"], "minimum": 0},
    "signals": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 64},
      "uniqueItems": true,
      "maxItems": 32
    }
  },
  "additionalProperties": true
}
