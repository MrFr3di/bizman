{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bizman/observation.schema.json",
  "title": "BizMan captured application event",
  "type": "object",
  "required": [
    "capture", "entry", "started_at", "method", "path", "query", "status",
    "mime_type", "resource_type", "response_size"
  ],
  "properties": {
    "capture": {"type": "string", "minLength": 1},
    "entry": {"type": "integer", "minimum": 0},
    "started_at": {"type": "string", "format": "date-time"},
    "method": {"type": "string", "minLength": 1},
    "path": {"type": "string", "pattern": "^/"},
    "query": {"type": "object"},
    "status": {"type": "integer", "minimum": 0, "maximum": 599},
    "mime_type": {"type": "string"},
    "resource_type": {"type": "string"},
    "response_size": {"type": "integer", "minimum": 0},
    "response_text_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
